PRODUCT_IDENTITY_ENVIRONMENT=development
PRODUCT_IDENTITY_DATABASE_URL=postgresql+psycopg://product_identity:change-me@localhost:5432/product_identity
PRODUCT_IDENTITY_AUTH_ISSUER=https://your-oidc-provider.example/
PRODUCT_IDENTITY_AUTH_AUDIENCE=product-identity-api
PRODUCT_IDENTITY_AUTH_ALGORITHM=RS256
# PEM public key or equivalent configured by the deployment secret store.
PRODUCT_IDENTITY_AUTH_JWT_KEY=
PRODUCT_IDENTITY_VERIFICATION_TOKEN_SECRET=replace-with-at-least-32-random-bytes\nPRODUCT_IDENTITY_PUBLIC_BASE_URL=http://localhost:5173
PRODUCT_IDENTITY_CORS_ORIGINS=["http://localhost:5173"]
PRODUCT_IDENTITY_PROOF_UPLOAD_SECRET=replace-with-at-least-32-random-bytes\nPRODUCT_IDENTITY_PROOF_RETENTION_DAYS=730\nPRODUCT_IDENTITY_PROOF_DOWNLOAD_TTL_SECONDS=300\nPRODUCT_IDENTITY_OBJECT_STORAGE_BUCKET=product-identity-private\nPRODUCT_IDENTITY_OBJECT_STORAGE_REGION=auto\nPRODUCT_IDENTITY_OBJECT_STORAGE_ENDPOINT_URL=\nPRODUCT_IDENTITY_OBJECT_STORAGE_ACCESS_KEY_ID=\nPRODUCT_IDENTITY_OBJECT_STORAGE_SECRET_ACCESS_KEY=\nPRODUCT_IDENTITY_VERIFICATION_REPEAT_SCAN_THRESHOLD=6\nPRODUCT_IDENTITY_VERIFICATION_REPEAT_SCAN_WINDOW_MINUTES=10\nPRODUCT_IDENTITY_VERIFICATION_COUNTRY_THRESHOLD=2\nPRODUCT_IDENTITY_VERIFICATION_COUNTRY_WINDOW_HOURS=24\nPRODUCT_IDENTITY_VERIFICATION_TRUST_EDGE_COUNTRY=false\nPRODUCT_IDENTITY_VERIFICATION_COUNTRY_HEADER=cf-ipcountry\n