name = "product-identity-api"
main = "worker.py"
compatibility_date = "2026-09-27"
compatibility_flags = ["python_workers"]
workers_dev = true

[observability]
enabled = true

[vars]
PRODUCT_IDENTITY_RUNTIME = "cloudflare-worker"
PRODUCT_IDENTITY_ENVIRONMENT = "production"
PRODUCT_IDENTITY_PUBLIC_BASE_URL = "__WEB_URL__"
PRODUCT_IDENTITY_CORS_ORIGINS = "[\"__WEB_URL__\"]"
PRODUCT_IDENTITY_SHOPIFY_CLIENT_ID = "__SHOPIFY_CLIENT_ID__"
PRODUCT_IDENTITY_SHOPIFY_API_VERSION = "2026-07"
PRODUCT_IDENTITY_SHOPIFY_SCOPES = "read_products,read_orders"
PRODUCT_IDENTITY_SHOPIFY_OAUTH_CALLBACK_URL = "__API_URL__/v1/integrations/shopify/oauth/callback"
PRODUCT_IDENTITY_SHOPIFY_AFTER_INSTALL_URL = "__WEB_URL__/app"

[[hyperdrive]]
binding = "HYPERDRIVE"
id = "__HYPERDRIVE_ID__"

[python_modules]
exclude = ["**/*.pyc", "**/__pycache__"]
